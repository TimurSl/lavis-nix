{
  "schema_version": 5,
  "id": "always-online",
  "name": "Always Online",
  "version": "0.1.0",
  "author": "zumuvik",
  "entrypoint": "always-online",
  "capabilities": [
    "timer",
    "telegram.invoke"
  ],
  "subscriptions": [
    {
      "type": "timer.tick",
      "interval_seconds": 30
    }
  ],
  "commands": [
    {
      "name": "online",
      "summary_ru": "Управление поддержанием статуса онлайн",
      "description_ru": "Включает, выключает или показывает состояние модуля Always Online.",
      "usage": "[on|off|status|interval <секунды>]",
      "examples": [
        "on",
        "off",
        "status",
        "interval 30"
      ]
    }
  ]
}
